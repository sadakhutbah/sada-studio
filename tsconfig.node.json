{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "paths": { "@core/*": ["./src/core/*"], "@shared/*": ["./src/shared/*"] }
  },
  "include": ["src/core", "src/main", "src/preload", "src/shared", "tests", "electron.vite.config.ts", "vitest.config.mts"]
}
