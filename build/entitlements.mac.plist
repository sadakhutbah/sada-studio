<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Required by the hardened runtime (needed for notarization) with Electron's JIT. -->
  <key>com.apple.security.cs.allow-jit</key><true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key><true/>
  <!-- Ad-hoc builds (no certificate): the Electron frameworks carry another signature. -->
  <key>com.apple.security.cs.disable-library-validation</key><true/>
  <!-- Camera and microphone: the whole point of the application. -->
  <key>com.apple.security.device.camera</key><true/>
  <key>com.apple.security.device.audio-input</key><true/>
</dict>
</plist>
