{
  "name": "sada-studio",
  "version": "0.2.5",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "Application compagnon de Sada : diffuser khutbah et dars sans OBS",
  "author": "Sada <contact@sadakhutbah.org>",
  "desktopName": "sada-studio.desktop",
  "homepage": "https://sadakhutbah.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thesadaproject/sada-studio.git"
  },
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "mock": "node scripts/mock-sada.mjs",
    "dist": "electron-vite build && electron-builder",
    "dist:mac": "node scripts/fetch-ffmpeg-mac.mjs && electron-vite build && electron-builder --mac --publish never",
    "dist:win": "node scripts/fetch-ffmpeg-win.mjs && electron-vite build && electron-builder --win --publish never",
    "icons": "node scripts/make-icons.mjs",
    "postinstall": "node scripts/brand-dev-electron.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "oxlint": "^1.94.0",
    "png2icons": "^2.0.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@fontsource/eb-garamond": "^5.3.0",
    "electron-updater": "^6.8.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
